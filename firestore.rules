rules_version = '2';

// ═══════════════════════════════════════════════════════════════════════════
//  OnWay — Firestore Security Rules
//  Last updated: 2026-06-26
//
//  Architecture note:
//  ──────────────────
//  ALL mutations (create / update / delete) happen exclusively through the
//  Express backend using Firebase Admin SDK, which bypasses these rules.
//  These rules therefore protect against:
//    • Direct client-side writes using the public Firebase config
//    • Unauthorized reads of sensitive data via client SDK
//    • Future accidental direct-read code paths
//
//  Access model:
//  ─────────────
//  PUBLIC READ     — browsable product/store data (no auth required)
//  BACKEND ONLY    — sensitive user, order, driver, financial data
//  DEFAULT DENY    — anything not explicitly listed → denied
// ═══════════════════════════════════════════════════════════════════════════

service cloud.firestore {
  match /databases/{database}/documents {

    // ── DEFAULT: deny everything not explicitly allowed ────────────────────
    match /{document=**} {
      allow read, write: if false;
    }


    // ══════════════════════════════════════════════════════════════════════
    //  PUBLIC READ-ONLY collections
    //  (client app displays this data before user logs in)
    // ══════════════════════════════════════════════════════════════════════

    // Product categories (grid on home screen)
    match /categories/{docId} {
      allow read: if true;
      allow write: if false;
    }

    // Home-screen banners and offer carousels
    match /banners/{docId} {
      allow read: if true;
      allow write: if false;
    }

    // Delivery areas and fees (shown during checkout)
    match /deliveryAreas/{docId} {
      allow read: if true;
      allow write: if false;
    }

    // Vendor / store listings (restaurants, pharmacies, etc.)
    //
    // BACKEND ONLY despite being browse data: vendor documents carry
    // `passwordHash` (bcrypt, written in server/vendor.ts when a store registers).
    // The REST layer strips that field in five separate places before responding,
    // which shows it is known-sensitive — but `allow read: if true` bypassed the
    // REST layer entirely and served the raw document, handing out every store's
    // password hash for offline cracking.
    //
    // Firestore rules cannot filter fields, so the collection must be closed.
    // Public store browsing is unaffected: it goes through /api/stores and
    // /api/vendors, which use the Admin SDK (rules do not apply) and return the
    // password-stripped shape. No client code reads this collection via the
    // Firebase client SDK — verified across the whole client tree.
    match /vendors/{docId} {
      allow read, write: if false;
    }

    // Products inside vendor stores
    //
    // BACKEND ONLY despite being browse data: each product document carries
    // `vendorPhone` — the store owner's personal number — and rules cannot filter
    // fields, so `allow read: if true` was a bulk harvest of every store owner's
    // phone number by anyone holding the (publicly shipped) Firebase web config.
    //
    // Public catalog browsing is unaffected: it goes through /api/stores/:id/products
    // and /api/products, which use the Admin SDK (rules do not apply). No client
    // code reads this collection via the Firebase client SDK — the only client SDK
    // reads in the whole tree are three `settlementLedger` document reads.
    match /vendorProducts/{docId} {
      allow read, write: if false;
    }

    // Legacy product collection (used alongside vendorProducts)
    match /products/{docId} {
      allow read: if true;
      allow write: if false;
    }

    // App-wide settings: delivery fee config, minimum order thresholds
    match /appSettings/{docId} {
      allow read: if true;
      allow write: if false;
    }

    // Alternate casing used in some code paths.
    //
    // BACKEND ONLY: this collection holds `app_settings/admin_push`, the admin's
    // Expo push token. Expo's send API is unauthenticated, so a readable token lets
    // anyone deliver notifications that appear to come from OnWay straight to the
    // owner's phone. It is written and read exclusively by the Admin SDK
    // (server/firebase.ts), which bypasses rules, so closing this costs nothing.
    match /app_settings/{docId} {
      allow read, write: if false;
    }

    // Promotional sections: Best Sellers, Featured, Discounts
    match /promotionalSections/{docId} {
      allow read: if true;
      allow write: if false;
    }


    // ══════════════════════════════════════════════════════════════════════
    //  BACKEND-ONLY — all writes AND reads via Admin SDK only
    //  (any direct client access → denied)
    // ══════════════════════════════════════════════════════════════════════

    // ── User data ──────────────────────────────────────────────────────────
    // Contains: name, phone, push token, saved addresses, loyalty points
    match /users/{docId} {
      allow read, write: if false;
    }

    match /addresses/{docId} {
      allow read, write: if false;
    }

    // ── Orders ────────────────────────────────────────────────────────────
    // Contains: items, prices, customer PII, delivery address
    match /orders/{docId} {
      allow read, write: if false;
    }

    // ── Driver system ─────────────────────────────────────────────────────
    match /drivers/{docId} {
      allow read, write: if false;
    }

    match /driverWallets/{docId} {
      allow read, write: if false;
    }

    match /walletHistory/{docId} {
      allow read, write: if false;
    }

    match /driverActivityLog/{docId} {
      allow read, write: if false;
    }

    match /driverCompletedOrders/{docId} {
      allow read, write: if false;
    }

    match /driverActivities/{docId} {
      allow read, write: if false;
    }

    // ── Batch delivery ────────────────────────────────────────────────────
    match /delivery_batches/{docId} {
      allow read, write: if false;
    }

    match /delivery_logs/{docId} {
      allow read, write: if false;
    }

    // ── Promo codes ───────────────────────────────────────────────────────
    match /promoCodes/{docId} {
      allow read, write: if false;
    }

    match /promoUsage/{docId} {
      allow read, write: if false;
    }

    match /promoUsageHistory/{docId} {
      allow read, write: if false;
    }

    // ── Notifications & push tokens ───────────────────────────────────────
    match /pushTokens/{docId} {
      allow read, write: if false;
    }

    match /notifications/{docId} {
      allow read, write: if false;
    }

    match /adminNotifications/{docId} {
      allow read, write: if false;
    }

    match /adminAlerts/{docId} {
      allow read, write: if false;
    }

    match /vendorNotifications/{docId} {
      allow read, write: if false;
    }

    // ── Support chat ──────────────────────────────────────────────────────
    match /supportChats/{docId} {
      allow read, write: if false;
    }

    match /support_chats/{docId} {
      allow read, write: if false;
    }

    // ── Admin ─────────────────────────────────────────────────────────────
    match /adminConfig/{docId} {
      allow read, write: if false;
    }

    // ── Financial / Settlement ─────────────────────────────────────────────
    // settlementLedger: read by vendor/driver client SDK via onSnapshot (VendorWalletScreen).
    // Document IDs are in the format "vendor:{uuid}" or "driver:{phone}" — obscure enough
    // to prevent guessing. Writes are Admin SDK only (backend-enforced, rules redundant).
    // ── FINANCIAL LEDGER — BACKEND ONLY ───────────────────────────────────
    // Aggregate balances per driver / vendor: outstandingTotal, totalGross,
    // totalCommission, totalOrders, totalSettled.
    //
    // This was `allow read: if true` so the client SDK could run onSnapshot for
    // live balance updates. That made every account's finances world-readable:
    // this app uses a custom JWT and NOT Firebase Auth, so request.auth is always
    // null and there is nothing else gating the read. Document ids are also
    // deterministic and enumerable — "driver:07XXXXXXXXX" / "vendor:<id>" — so
    // anyone with the (publicly shipped) Firebase web config could harvest every
    // driver's debt and every vendor's revenue.
    //
    // Balances are served instead by the JWT-authorised REST endpoints
    // (/api/driver/status, /api/vendor/settlement, /api/vendor/wallet). The three
    // screens that used onSnapshot already fall back to those values, so closing
    // this costs live push-updates only — no feature is lost.
    match /settlementLedger/{docId} {
      allow read, write: if false;
    }

    match /settlements/{docId} {
      allow read, write: if false;
    }

    match /settlementRequests/{docId} {
      allow read, write: if false;
    }

    match /settlementPayments/{docId} {
      allow read, write: if false;
    }

    match /driverFinancialAccounts/{docId} {
      allow read, write: if false;
    }

    match /driverTransactions/{docId} {
      allow read, write: if false;
    }

    match /promoUsageHistory/{docId} {
      allow read, write: if false;
    }

    // ── Internal / cache ──────────────────────────────────────────────────
    match /productImageHashes/{docId} {
      allow read, write: if false;
    }
  }
}
